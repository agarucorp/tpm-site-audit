# Pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tpm_audit?schema=public"
# Direct (non-pooled) connection string (used by Prisma migrations).
# Locally it can be the same as DATABASE_URL. Neon on Vercel sets this automatically.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/tpm_audit?schema=public"
